<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>TuxViewer</AssemblyName>
    <RootNamespace>TuxViewer</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
    <AssemblyTitle>TuxViewer</AssemblyTitle>
    <Product>TuxViewer</Product>
    <Description>Linux desktop and window inspector for X11, XWayland and Wayland</Description>
    <Authors>TuxViewer contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/tuxviewer.png" />
    <EmbeddedResource Include="Assets/gnome-extension/extension.js" />
    <EmbeddedResource Include="Assets/gnome-extension/metadata.json" />
  </ItemGroup>

</Project>

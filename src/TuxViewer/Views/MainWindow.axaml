<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:TuxViewer.Models"
        xmlns:vm="using:TuxViewer.ViewModels"
        x:Class="TuxViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{DynamicResource Ui_TuxViewer_Linux_Window_Inspector}"
        Icon="avares://TuxViewer/Assets/tuxviewer.png"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

  <Window.Resources>
    <DataTemplate x:Key="InfoRowTemplate" x:DataType="models:InfoRow">
      <Grid ColumnDefinitions="176,*,Auto" Margin="0,2" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" Foreground="#8795AB" FontSize="12"
                   LineHeight="18" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Spacing="1">
          <SelectableTextBlock Text="{Binding Value}"
                               FontFamily="{Binding FontFamily}" FontSize="12"
                               LineHeight="18" Foreground="#DCE5F4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChangeText}" IsVisible="{Binding IsChanged}"
                     FontSize="10" Foreground="#F6C177" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2" Classes="change-badge" IsVisible="{Binding IsChanged}"
                VerticalAlignment="Top" Margin="0,2,0,0">
          <TextBlock Text="CHANGED" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="X11PropertyTemplate" x:DataType="models:X11Property">
      <Border Classes="card" Classes.changed="{Binding IsChanged}" Margin="0,0,0,4" Padding="10,7">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding NameAndType}" FontSize="11" Foreground="#8FA6C9"
                       FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                       TextWrapping="Wrap" />
            <Border Grid.Column="1" Classes="change-badge" IsVisible="{Binding IsChanged}">
              <TextBlock Text="CHANGED" />
            </Border>
          </Grid>
          <SelectableTextBlock Text="{Binding Value}" FontSize="12"
                               FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                               Foreground="#DCE5F4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChangeText}" IsVisible="{Binding IsChanged}"
                     FontSize="10" Foreground="#F6C177"
                     FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="X11RecordTemplate" x:DataType="models:X11RecordedEvent">
      <Grid ColumnDefinitions="86,116,104,*" ColumnSpacing="8" Margin="0,1">
        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#66758C"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="10" Foreground="#9BC0FF"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding WindowHex}" FontSize="10" Foreground="#F0B57D"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Foreground="#C6D3E8"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Summary}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EventTemplate" x:DataType="models:WindowEventRecord">
      <Grid ColumnDefinitions="86,64,96,*" ColumnSpacing="8" Margin="0,1">
        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#66758C"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1" Classes="tag" HorizontalAlignment="Left"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Source}" />
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="10" Foreground="#9BC0FF"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Foreground="#C6D3E8"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Summary}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="X11ChildTemplate" x:DataType="models:X11ChildInfo">
      <Border Classes="card" Margin="0,0,0,3" Padding="9,6">
        <SelectableTextBlock Text="{Binding DisplayText}" FontSize="11"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             Foreground="#C6D3E8" TextWrapping="Wrap" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ProviderTemplate" x:DataType="models:ProviderStatus">
      <Border Classes="provider" Classes.available="{Binding Available}">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
            <Border Grid.Column="1">
              <Border Classes="badge" Classes.accent="{Binding Available}">
                <TextBlock Text="{Binding AvailabilityText}" />
              </Border>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Detail}" Classes="hint" />
          <TextBlock Text="{Binding CapabilityText}" Classes="hint" Foreground="#6E7F98" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar -->
    <Border Grid.Row="0" Background="#0E131D" BorderBrush="#222B3B" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="11" Background="#4F8CFF">
            <TextBlock Text="TV" FontSize="15" FontWeight="Bold" Foreground="#08101E"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="TuxViewer" FontSize="20" FontWeight="Bold" LetterSpacing="0.4" />
            <TextBlock Text="{DynamicResource Ui_Linux_desktop_window_inspector}" FontSize="11" Foreground="#7E8CA3" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Classes="badge accent">
            <TextBlock Text="{Binding SessionSummary}" />
          </Border>
          <Border Classes="badge">
            <TextBlock Text="{Binding CountsText}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding AutoRefresh}">
            <TextBlock Text="{Binding AutoRefreshBadge}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
          <Button Content="{Binding LanguageButtonText}" Click="ToggleLanguage_Click" Classes="ghost"
                  ToolTip.Tip="{Binding LanguageToolTip}" />
          <Button Content="{DynamicResource Ui_Refresh}" Click="Refresh_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_Refresh_window_list_F5}" />
          <Button Content="{DynamicResource Ui_Current_focus}" Click="Focused_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_Read_the_currently_focused_window}" />
          <Button Content="{DynamicResource Ui_Pick_click}" Click="Pick_Click" Classes="pick"
                  IsEnabled="{Binding IsIdle}" ToolTip.Tip="{DynamicResource Ui_Click_mode_click_the_target_window_F2}" />
          <Button Content="{DynamicResource Ui_Pick_drag}" Click="PickDrag_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_Drag_mode_hold_the_left_button_drag_the_crosshai}" />
          <Button Content="{DynamicResource Ui_Pick_X11}" Click="PickX11_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="{DynamicResource Ui_Use_X11_pointer_grab_only_Shift_F2_Shift_F3_X11_}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1">
      <Grid ColumnDefinitions="470,6,*">

        <!-- Window list -->
        <Border Grid.Column="0" Classes="panel" Margin="12,12,0,12" ClipToBounds="True">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="12,12,12,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox PlaceholderText="{DynamicResource Ui_Search_title_app_ID_PID_window_ID_regex_supporte}"
                         Text="{Binding FilterText, Mode=TwoWay}" />
                <ToggleButton Grid.Column="1" Content=".*" Classes="chip" Width="38"
                              IsChecked="{Binding UseRegexSearch, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Ui_Regex_search_match_all_searchable_window_fields_}" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding BackendFilters}"
                          SelectedIndex="{Binding BackendFilterIndex, Mode=TwoWay}" />
                <ToggleButton Grid.Column="1" Content="{DynamicResource Ui_Auto_refresh}" Classes="chip"
                              IsChecked="{Binding AutoRefresh, Mode=TwoWay}" Margin="8,0,0,0" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,8,0,0">
                <TextBox PlaceholderText="{DynamicResource Ui_PID_comma_separated}"
                         Text="{Binding PidFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="1" PlaceholderText="{DynamicResource Ui_Window_ID_0x}"
                         Text="{Binding WindowIdFilterText, Mode=TwoWay}" />
                <TextBox Grid.Column="2" PlaceholderText="{DynamicResource Ui_Workspace_name_number}"
                         Text="{Binding WorkspaceFilterText, Mode=TwoWay}" />
              </Grid>
              <WrapPanel Grid.Row="3" Margin="0,8,0,0" ItemSpacing="5" LineSpacing="5">
                <ToggleButton Content="{DynamicResource Ui_Hide_this_app}" Classes="chip"
                              IsChecked="{Binding HideOwnWindows, Mode=TwoWay}" />
                <ToggleButton Content="{DynamicResource Ui_Include_raw_X11}" Classes="chip"
                              IsChecked="{Binding IncludeRawX11, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Ui_Show_raw_X11_windows_merged_into_Wayland_entries}" />
                <ToggleButton Content="{DynamicResource Ui_Include_unmapped}" Classes="chip"
                              IsChecked="{Binding IncludeUnmapped, Mode=TwoWay}" />
                <ToggleButton Content="{DynamicResource Ui_Live_events}" Classes="chip"
                              IsChecked="{Binding RealtimeEnabled, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Ui_Listen_to_X11_PropertyNotify_niri_Sway_Hyprland_}" />
                <ToggleButton Content="{DynamicResource Ui_Tree_view}" Classes="chip"
                              IsChecked="{Binding TreeMode, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Ui_Group_by_app_process_workspace_and_expand_X11_ch}" />
                <ToggleButton Content="{DynamicResource Ui_This_PID_only}" Classes="chip"
                              IsChecked="{Binding OnlySelectedPid, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Ui_Show_only_windows_with_the_selected_window_s_PID}" />
              </WrapPanel>
              <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                    Margin="0,8,0,0" IsVisible="{Binding TreeMode}">
                <TextBlock Text="{DynamicResource Ui_Group_by}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TreeGroupModes}"
                          SelectedIndex="{Binding TreeGroupModeIndex, Mode=TwoWay}" />
              </Grid>
              <StackPanel Grid.Row="5" Spacing="6" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <ComboBox ItemsSource="{Binding FilterPresets}"
                            SelectedIndex="{Binding SelectedFilterPresetIndex, Mode=TwoWay}"
                            PlaceholderText="{DynamicResource Ui_Filter_presets}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:FilterPreset">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Content="{DynamicResource Ui_Apply}" Click="ApplyFilterPreset_Click"
                          Classes="ghost" FontSize="11" Padding="8,4" />
                  <Button Grid.Column="2" Content="{DynamicResource Ui_Delete}" Click="DeleteFilterPreset_Click"
                          Classes="ghost" FontSize="11" Padding="8,4" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBox PlaceholderText="{DynamicResource Ui_Preset_name_leave_empty_to_auto_name}"
                           Text="{Binding FilterPresetName, Mode=TwoWay}" />
                  <Button Grid.Column="1" Content="{DynamicResource Ui_Save_current_filter}" Click="SaveFilterPreset_Click"
                          Classes="ghost" FontSize="11" Padding="8,4" />
                  <Button Grid.Column="2" Content="{DynamicResource Ui_Clear}" Click="ResetFilters_Click"
                          Classes="ghost" FontSize="11" Padding="8,4" />
                </Grid>
                <TextBlock Text="{Binding FilterError}" IsVisible="{Binding HasFilterError}"
                           Foreground="#F7768E" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,12,12,6">
              <TextBlock Text="{DynamicResource Ui_Windows_TOPLEVEL}" Classes="section" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding FilterSummaryText}" FontSize="11"
                         Foreground="#F6C177" VerticalAlignment="Center" Margin="8,0" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Source_Backend_Geometry}" FontSize="11" Foreground="#66758C" />
            </Grid>

            <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                     Margin="8,0,8,8" IsVisible="{Binding !TreeMode}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WindowInfo">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Height="44">
                    <Panel Width="36" Height="36" VerticalAlignment="Center">
                      <Border CornerRadius="9" Background="#1B2638" BorderBrush="#2A3850"
                              BorderThickness="1">
                        <TextBlock Text="{Binding IconInitial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AFC3E4" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="9" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 LineHeight="18" TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Border Classes="tag" Classes.x11="{Binding IsX11}"
                                Classes.wl="{Binding IsWayland}"
                                ToolTip.Tip="{Binding BackendLabel}">
                          <TextBlock Text="{Binding BackendShort}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="#7E8CA3" LineHeight="15"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#93A4BC"
                                 FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                 LineHeight="14" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding FocusGlyph}" FontSize="10" Foreground="#4F8CFF"
                                 LineHeight="14" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TreeView ItemsSource="{Binding WindowTree}"
                      SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                      IsVisible="{Binding TreeMode}" Margin="8,0,8,8">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="2,1" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:WindowNode">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8" Height="44" Margin="0,1">
                    <Panel Width="36" Height="36" VerticalAlignment="Center">
                      <Border CornerRadius="9" Background="#1B2638" BorderBrush="#2A3850"
                              BorderThickness="1">
                        <TextBlock Text="{Binding IconInitial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AFC3E4" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="9" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 LineHeight="18" TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Border Classes="tag" Classes.x11="{Binding IsX11}"
                                Classes.wl="{Binding IsWayland}"
                                IsVisible="{Binding IsWindow}"
                                ToolTip.Tip="{Binding BackendLabel}">
                          <TextBlock Text="{Binding BackendShort}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="#7E8CA3" LineHeight="15"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#93A4BC"
                                 FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                 LineHeight="14" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding FocusGlyph}" FontSize="10" Foreground="#4F8CFF"
                                 LineHeight="14" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Column="2" Classes="panel" Margin="0,12,12,12" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#101724" BorderBrush="#232C3D" BorderThickness="0,0,0,1"
                    Padding="16,12">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="Bold"
                             LineHeight="24" Height="28" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SelectedTitle}" />
                  <TextBlock Text="{Binding SelectedSubtitle}" FontSize="11" Foreground="#7E8CA3"
                             LineHeight="16" Height="18" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SelectedSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Top">
                  <Border Classes="badge" Classes.x11="{Binding SelectedWindow.IsX11}"
                          Classes.wl="{Binding SelectedWindow.IsWayland}">
                    <TextBlock Text="{Binding SelectedBackend}" />
                  </Border>
                  <Border Classes="badge">
                    <TextBlock Text="{Binding SelectedPid}" />
                  </Border>
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                      Margin="0,10,0,0">
                  <Button Content="{DynamicResource Ui_Copy_summary}" Click="CopySummary_Click" Classes="ghost" IsEnabled="{Binding HasSelection}" />
                  <Button Grid.Column="1" Content="{DynamicResource Ui_Copy_JSON}" Click="CopyJson_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <Button Grid.Column="2" Content="{DynamicResource Ui_Screenshot}" Click="Screenshot_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0"
                          ToolTip.Tip="{DynamicResource Ui_Capture_the_selected_window_X11_XGetImage_niri_g}" />
                  <Button Grid.Column="3" Content="{DynamicResource Ui_Highlight}" Click="Highlight_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0"
                          ToolTip.Tip="{DynamicResource Ui_Draw_a_border_on_the_X11_screen_use_Focus_for_Wa}" />
                  <Button Grid.Column="4" Content="{DynamicResource Ui_Focus}" Click="Focus_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <Button Grid.Column="5" Content="{DynamicResource Ui_Close_window}" Click="Close_Click" Classes="danger"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <TextBlock Grid.Column="6" Text="{Binding SelectedId, StringFormat='ID {0}'}" Classes="muted" FontSize="10"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </Grid>
              </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="10,8,10,10"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
              <TabItem Header="{DynamicResource Ui_Overview}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="{DynamicResource Ui_Window_properties}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OverviewRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <Border Classes="divider" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_When_Backend_is_X11_the_window_is_an_X11_client_}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Process}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="{Binding ProcessHeader}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Toolkit_evidence}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ToolkitEvidence}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Key_shared_libraries}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding KeyLibraries}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                       FontSize="10" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_X11_properties}">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="6,8,10,8">
                  <TextBlock Grid.Row="0" Text="{DynamicResource Ui_X11_window_properties}" Classes="section" Margin="0,0,0,6" />
                  <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                  </ScrollViewer>
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,12,0,6">
                    <TextBlock Text="{Binding X11PropertyCountText}"
                               Classes="section" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Width="300" PlaceholderText="{DynamicResource Ui_Filter_property_name_type_value}"
                             Text="{Binding PropertyFilterText, Mode=TwoWay}" />
                  </Grid>
                  <ScrollViewer Grid.Row="3" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Properties}" ItemTemplate="{StaticResource X11PropertyTemplate}" />
                  </ScrollViewer>
                  <TextBlock Grid.Row="4" Text="{Binding X11ChildCountText}"
                             Classes="section" Margin="0,12,0,6" IsVisible="{Binding HasX11Details}" />
                  <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Children}" ItemTemplate="{StaticResource X11ChildTemplate}" />
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <TabItem Header="Wayland">
                <Grid RowDefinitions="Auto,*" Margin="6,8,10,8">
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding WaylandRows}"
                                ItemTemplate="{StaticResource InfoRowTemplate}" />
                  <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource Ui_Raw_compositor_data}" Classes="section" Margin="0,0,0,6" />
                      <SelectableTextBlock Text="{Binding NativeJson}" FontSize="11"
                                           FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                           Foreground="#B9C9E2" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Environment}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="{DynamicResource Ui_Process_environment_priority_order}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding EnvironmentRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Socket_connections}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SocketRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Raw_data}">
                <Grid RowDefinitions="Auto,*" Margin="6,8,10,8">
                  <TextBlock Grid.Row="0" Text="{DynamicResource Ui_Full_inspection_JSON_window_process_X11_properti}"
                             Classes="section" Margin="0,0,0,6" />
                  <TextBox Grid.Row="1" Text="{Binding RawJson}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                           FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Events}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6,8,10,8">
                  <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="{DynamicResource Ui_Live_events}" Classes="section" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="badge accent" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RealtimeSummary}" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding EventCountText}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Content="{DynamicResource Ui_Clear_2}" Click="ClearEvents_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                      <Button Grid.Column="4" Content="{DynamicResource Ui_Copy}" Click="CopyEvents_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="hint" Margin="0,6,0,0"
                               Text="{DynamicResource Ui_Live_events_come_from_X11_PropertyNotify_Configu}" />
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Events}"
                           ItemTemplate="{StaticResource EventTemplate}">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                  <TextBlock Grid.Row="2" Classes="hint" Margin="0,6,0,0"
                             Text="{DynamicResource Ui_Note_only_the_latest_800_events_are_kept_no_new_}" />
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Screenshot}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6,8,10,8">
                  <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                      <Button Content="{DynamicResource Ui_Recapture}" Click="Screenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasSelection}" FontSize="11" Padding="9,4" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Save_PNG}" Click="SaveScreenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasScreenshot}" FontSize="11" Padding="9,4" />
                      <Button Grid.Column="2" Content="{DynamicResource Ui_Copy_image}" Click="CopyScreenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasScreenshot}" FontSize="11" Padding="9,4" />
                      <TextBlock Grid.Column="4" Text="{Binding ScreenshotStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="520"
                                 ToolTip.Tip="{Binding ScreenshotStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="hint" Margin="0,6,0,0"
                               Text="{DynamicResource Ui_X11_XWayland_captures_the_window_precisely_with_}" />
                  </Grid>
                  <Border Grid.Row="1" Classes="panel" Background="#0A0E15" ClipToBounds="True">
                    <Panel>
                      <Image Source="{Binding ScreenshotImage}" Stretch="Uniform" Margin="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="{DynamicResource Ui_No_screenshot_yet_use_Screenshot_in_the_toolbar_}"
                                 Classes="muted" FontSize="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasScreenshot}" />
                    </Panel>
                  </Border>
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ScreenshotSourceText}"
                               Classes="muted" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint"
                               Text="{DynamicResource Ui_Screenshots_are_kept_in_memory_only_click_Save_P}" />
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Rules}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="Auto,180,*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{DynamicResource Ui_Target_compositor}" Classes="section" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding RuleCompositors}"
                                SelectedIndex="{Binding RuleCompositorIndex, Mode=TwoWay}" />
                      <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                                 Text="{DynamicResource Ui_Generate_paste_ready_configuration_for_the_selec}" />
                    </Grid>

                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                      <CheckBox Content="{DynamicResource Ui_Floating}" IsChecked="{Binding RuleFloating, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Fullscreen}" IsChecked="{Binding RuleFullscreen, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Borderless}" IsChecked="{Binding RuleNoBorder, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Sticky}" IsChecked="{Binding RuleSticky, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Match_title_too}" IsChecked="{Binding RuleMatchTitle, Mode=TwoWay}" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,110,Auto,110,Auto,160,*" ColumnSpacing="8">
                      <TextBlock Text="{DynamicResource Ui_Width}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding RuleWidth, Mode=TwoWay}"
                               PlaceholderText="{DynamicResource Ui_Leave_empty_for_no_limit}" />
                      <TextBlock Grid.Column="2" Text="{DynamicResource Ui_Height}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding RuleHeight, Mode=TwoWay}"
                               PlaceholderText="{DynamicResource Ui_Leave_empty_for_no_limit}" />
                      <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Workspace}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="5" Text="{Binding RuleWorkspace, Mode=TwoWay}"
                               PlaceholderText="{DynamicResource Ui_Name_number}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="8">
                      <TextBlock Text="{DynamicResource Ui_Opacity}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding RuleOpacity, Mode=TwoWay}"
                               PlaceholderText="0.0 - 1.0" />
                      <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                 Text="{DynamicResource Ui_Leave_empty_to_skip_the_opacity_rule_niri_Sway_H}" />
                    </Grid>

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Ui_Generated_configuration}" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Copy_rule}" Click="CopyRule_Click"
                              Classes="ghost" FontSize="11" Padding="9,4" />
                    </Grid>
                    <TextBox Text="{Binding GeneratedRule}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             FontSize="12" MinHeight="260"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_The_result_is_only_a_starting_point_verify_app_i}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_X11_events}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="6,8,10,8">
                  <Grid RowDefinitions="Auto,Auto">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="X11 RECORD" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{Binding X11RecordButtonText}"
                              Click="ToggleX11Record_Click" Classes="pick"
                              FontSize="11" Padding="10,4" />
                      <TextBlock Grid.Column="2" Text="{Binding X11RecordStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding X11EventCountText}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                      <Button Grid.Column="4" Content="{DynamicResource Ui_Clear_2}" Click="ClearX11Events_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                      <Button Grid.Column="5" Content="{DynamicResource Ui_Copy}" Click="CopyX11Events_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" ItemSpacing="12" LineSpacing="5">
                      <CheckBox Content="{DynamicResource Ui_Keyboard}" IsChecked="{Binding X11RecordKeys, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Mouse}" IsChecked="{Binding X11RecordMouse, Mode=TwoWay}" />
                      <CheckBox Content="Configure" IsChecked="{Binding X11RecordConfigure, Mode=TwoWay}" />
                      <CheckBox Content="Property" IsChecked="{Binding X11RecordProperty, Mode=TwoWay}" />
                      <CheckBox Content="Focus" IsChecked="{Binding X11RecordFocus, Mode=TwoWay}" />
                      <CheckBox Content="Map / Unmap" IsChecked="{Binding X11RecordMap, Mode=TwoWay}" />
                      <CheckBox Content="ClientMessage" IsChecked="{Binding X11RecordClientMessage, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Other}" IsChecked="{Binding X11RecordOther, Mode=TwoWay}" />
                      <CheckBox Content="{DynamicResource Ui_Watch_selected_window_only}" IsChecked="{Binding X11RecordOnlySelected, Mode=TwoWay}" />
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Classes="hint" Margin="0,8,0,8"
                             Text="{DynamicResource Ui_Uses_the_libXtst_RECORD_extension_to_record_even}" />
                  <ListBox Grid.Row="2" ItemsSource="{Binding X11Events}"
                           ItemTemplate="{StaticResource X11RecordTemplate}">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Controls}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="6,8,10,8">
                  <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource Ui_AT_SPI_control_tree}" Classes="section" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{DynamicResource Ui_Load_control_tree}" Click="LoadAtspi_Click"
                            Classes="ghost" FontSize="11" Padding="9,4" />
                    <Button Grid.Column="2" Content="{DynamicResource Ui_Copy}" Click="CopyAtspi_Click"
                            Classes="ghost" FontSize="11" Padding="9,4" />
                    <TextBlock Grid.Column="3" Text="{Binding AtspiStatus}" Classes="muted"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AtspiStatus}" />
                    <TextBlock Grid.Column="4" Text="{Binding AtspiCountText}" Classes="muted"
                               FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Row="1" Classes="hint" Margin="0,8,0,8"
                             Text="{DynamicResource Ui_Reads_the_accessibility_control_tree_of_GTK_Qt_a}" />
                  <Panel Grid.Row="2">
                    <TreeView ItemsSource="{Binding AtspiTree}">
                      <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                          <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                        </Style>
                      </TreeView.Styles>
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:AtspiNode">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="30" Margin="0,1">
                            <Border Classes="tag" VerticalAlignment="Center" MaxWidth="180">
                              <TextBlock Text="{Binding RoleShort}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{Binding Title}" FontSize="12"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                         FontSize="10" Foreground="#7E8CA3"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="{DynamicResource Ui_Not_loaded_click_Load_control_tree_above}"
                               Classes="muted" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasAtspiTree}" />
                  </Panel>
                </Grid>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Hotkey}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <TextBlock Text="{DynamicResource Ui_Global_pick_hotkey}" Classes="section" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Button Content="{Binding GlobalHotkeyButtonText}" Click="ToggleHotkey_Click"
                              Classes="pick" FontSize="11" Padding="10,4" />
                      <TextBlock Grid.Column="1" Text="{Binding GlobalHotkeyStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Border Grid.Column="2" Classes="badge accent">
                        <TextBlock Text="Ctrl+Alt+X" />
                      </Border>
                    </Grid>
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_When_enabled_registers_system_wide_Ctrl_Alt_X_th}" />

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Ui_Compositor_keybinding_configuration}" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Copy_configuration}" Click="CopyHotkey_Click"
                              Classes="ghost" FontSize="11" Padding="9,4" />
                    </Grid>
                    <TextBox Text="{Binding HotkeyConfig}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             FontSize="12" MinHeight="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_Add_the_matching_line_to_the_compositor_configur}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Control}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Ui_Window_state}" Classes="section" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ControlStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="520"
                                 ToolTip.Tip="{Binding ControlStatus}" />
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <Button Content="{DynamicResource Ui_Keep_above}" Tag="above" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Keep_below}" Tag="below" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Clear_above_below}" Tag="clearabove" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Fullscreen}" Tag="fullon" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Exit_fullscreen}" Tag="fulloff" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Toggle_floating}" Tag="floating" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Enable_sticky}" Tag="stickyon" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Disable_sticky}" Tag="stickoff" Click="ControlAction_Click" Classes="ghost" />
                    </WrapPanel>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Opacity_X11_XWayland}" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                      <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                              Value="{Binding OpacityValue, Mode=TwoWay}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OpacityValue, StringFormat='{}{0:0}%'}"
                                 Classes="muted" VerticalAlignment="Center" MinWidth="42" />
                      <Button Grid.Column="2" Content="{DynamicResource Ui_Apply}" Tag="opacity"
                              Click="ControlAction_Click" Classes="ghost" />
                      <Button Grid.Column="3" Content="{DynamicResource Ui_Clear}" Tag="clearopacity"
                              Click="ControlAction_Click" Classes="ghost" />
                    </Grid>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Geometry_X11_Sway_niri_only_supports_width_heigh}" Classes="section" />
                    <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,100,Auto,100,*" ColumnSpacing="8">
                      <TextBlock Text="X" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding GeoX, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="Y" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding GeoY, Mode=TwoWay}" />
                      <TextBlock Grid.Column="4" Text="{DynamicResource Ui_Width_2}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="5" Text="{Binding GeoW, Mode=TwoWay}" />
                      <TextBlock Grid.Column="6" Text="{DynamicResource Ui_Height_2}" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="7" Text="{Binding GeoH, Mode=TwoWay}" />
                      <Button Grid.Column="8" Content="{DynamicResource Ui_Apply_geometry}" Tag="geometry"
                              Click="ControlAction_Click" Classes="ghost" HorizontalAlignment="Left" />
                    </Grid>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Process}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,8,0,0">
                      <Button Content="{DynamicResource Ui_Send_close_request}" Tag="close" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{Binding ForceKillButtonText}" Tag="kill"
                              Click="ControlAction_Click" Classes="danger" />
                      <Button Content="{DynamicResource Ui_Open_executable_directory}" Tag="openfolder" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Copy_process_info}" Tag="copyproc" Click="ControlAction_Click" Classes="ghost" />
                    </WrapPanel>
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_Force_kill_only_calls_XKillClient_for_X11_XWayla}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Report}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource Ui_Export_current_inspection}" Classes="section" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ReportStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <Button Content="{DynamicResource Ui_Export_HTML}" Click="ExportHtml_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Export_Markdown}" Click="ExportMarkdown_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Export_JSON}" Click="ExportJson_Click" Classes="ghost" />
                    </WrapPanel>
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_The_export_contains_the_window_overview_process_}" />

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Window_snapshots}" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding SnapshotName, Mode=TwoWay}"
                               PlaceholderText="{DynamicResource Ui_Snapshot_name_optional_defaults_to_title_time}" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Save_current_snapshot}" Click="SaveSnapshot_Click" Classes="ghost" />
                      <Button Grid.Column="2" Content="{DynamicResource Ui_Refresh_list}" Click="RefreshSnapshots_Click" Classes="ghost" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Snapshots}"
                             SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                             MaxHeight="180">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:WindowSnapshot">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding DisplayText}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7E8CA3"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <Button Content="{DynamicResource Ui_Compare_selected_snapshot}" Click="CompareSnapshot_Click" Classes="ghost" />
                      <Button Content="{DynamicResource Ui_Delete_selected_snapshot}" Click="DeleteSnapshot_Click" Classes="danger" />
                      <TextBlock Text="{Binding SnapshotStatus}" Classes="muted" FontSize="11"
                                 VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBox Text="{Binding SnapshotDiffText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             FontSize="11" MinHeight="180"
                             IsVisible="{Binding HasSnapshotDiff}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_Snapshots_are_saved_under_XDG_STATE_HOME_TuxView}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Outputs}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <TextBlock Text="{DynamicResource Ui_Displays_outputs}" Classes="section" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OutputStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Content="{DynamicResource Ui_Refresh_outputs}" Click="RefreshOutputs_Click"
                              Classes="ghost" FontSize="11" Padding="9,4" />
                    </Grid>
                    <TextBlock Text="{Binding OutputNote}" Classes="hint"
                               IsVisible="{Binding OutputNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ItemsControl ItemsSource="{Binding Outputs}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:OutputInfo">
                          <Border Classes="card" Margin="0,0,0,6">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                              <Border Grid.Column="1" Classes="tag">
                                <TextBlock Text="{Binding GeometryText}" />
                              </Border>
                              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                         Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="{Binding ScaleLabel}" FontSize="10" Foreground="#93A4BC" />
                                <TextBlock Text="{Binding RefreshLabel}" FontSize="10" Foreground="#93A4BC" />
                                <TextBlock Text="{Binding TransformLabel}" FontSize="10" Foreground="#93A4BC" />
                                <TextBlock Text="{Binding ModeLabel}" FontSize="10" Foreground="#93A4BC" />
                                <TextBlock Text="{Binding WorkspaceLabel}" FontSize="10" Foreground="#93A4BC" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Workspace}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding OutputWorkspaces}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="6" LineSpacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkspaceInfo">
                          <Border Classes="tag" Padding="8,4" ToolTip.Tip="{Binding Subtitle}">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                              <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#7E8CA3" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Workspaces_column_layout}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding OutputLayoutLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <SelectableTextBlock Text="{Binding}" FontSize="11"
                                               FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                               Foreground="#C6D3E8" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_Output_coordinates_come_from_the_compositor_s_lo}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="{DynamicResource Ui_Diagnostics}">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                      <TextBlock Text="{DynamicResource Ui_Diagnostics_bundle}" Classes="section"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Export_diagnostics_bundle}"
                              Click="ExportDiagnosticsBundle_Click" Classes="ghost"
                              FontSize="11" Padding="9,4"
                              IsEnabled="{Binding !IsExportingDiagnosticsBundle}" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{DynamicResource Ui_Bundle_hint}" />
                    <SelectableTextBlock Text="{Binding DiagnosticsBundleStatus}"
                                         IsVisible="{Binding HasDiagnosticsBundleStatus}"
                                         FontSize="10" Foreground="#8FA6C9"
                                         FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                         TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Session}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SessionRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Live_monitoring}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding RealtimeRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <TextBlock Text="{DynamicResource Ui_Window_backends}" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{DynamicResource Ui_Refresh_diagnostics}" Click="RefreshDiagnostics_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource ProviderTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Wayland_global_protocols_wayland_info}" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding WaylandProtocols}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" FontSize="10" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_GNOME_support}" Classes="section" Margin="0,0,0,6" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_GNOME_Shell_forbids_third_party_window_list_acce}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                      <Button Content="{DynamicResource Ui_Install_GNOME_extension}" Click="InstallGnome_Click" Classes="ghost" />
                      <TextBlock Text="{Binding GnomeInstallStatus}" Classes="hint" VerticalAlignment="Center"
                                 MaxWidth="520" />
                    </StackPanel>

                    <Border Classes="divider" />
                    <TextBlock Text="{DynamicResource Ui_Limitations}" Classes="section" Margin="0,0,0,6" />
                    <TextBlock Classes="hint"
                               Text="{DynamicResource Ui_Wayland_does_not_allow_regular_clients_to_grab_i}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>

      <!-- Pick banner -->
      <Border IsVisible="{Binding IsPicking}" ZIndex="10"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
              Background="#F2172338" BorderBrush="#4F8CFF" BorderThickness="1" CornerRadius="10"
              Padding="14,10" BoxShadow="0 8 30 0 #80000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="◎" FontSize="20" Foreground="#7EABFF" VerticalAlignment="Center" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding PickBanner}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Ui_Tip_click_mode_clicks_the_target_drag_mode_holds}" FontSize="10" Foreground="#7E8CA3" />
          </StackPanel>
          <Border Classes="badge accent" IsVisible="{Binding HasPickCountdown}">
            <TextBlock Text="{Binding PickCountdown}" />
          </Border>
          <Button Content="{DynamicResource Ui_Cancel}" Click="CancelPick_Click" Classes="ghost" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#0E131D" BorderBrush="#222B3B" BorderThickness="0,1,0,0"
            Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#93A4BC"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Session.SessionType}" FontSize="10"
                   Foreground="#66758C" Margin="10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding UpdatedText}"
                   FontSize="10" Foreground="#66758C" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:TuxViewer.Models"
        xmlns:vm="using:TuxViewer.ViewModels"
        x:Class="TuxViewer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TuxViewer — Linux 窗口检视器"
        Icon="avares://TuxViewer/Assets/tuxviewer.png"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

  <Window.Resources>
    <DataTemplate x:Key="InfoRowTemplate" x:DataType="models:InfoRow">
      <Grid ColumnDefinitions="176,*,Auto" Margin="0,2" ColumnSpacing="8">
        <TextBlock Text="{Binding Label}" Foreground="#8795AB" FontSize="12"
                   LineHeight="18" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Spacing="1">
          <SelectableTextBlock Text="{Binding Value}"
                               FontFamily="{Binding FontFamily}" FontSize="12"
                               LineHeight="18" Foreground="#DCE5F4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChangeText}" IsVisible="{Binding IsChanged}"
                     FontSize="10" Foreground="#F6C177" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2" Classes="change-badge" IsVisible="{Binding IsChanged}"
                VerticalAlignment="Top" Margin="0,2,0,0">
          <TextBlock Text="CHANGED" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="X11PropertyTemplate" x:DataType="models:X11Property">
      <Border Classes="card" Classes.changed="{Binding IsChanged}" Margin="0,0,0,4" Padding="10,7">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding NameAndType}" FontSize="11" Foreground="#8FA6C9"
                       FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                       TextWrapping="Wrap" />
            <Border Grid.Column="1" Classes="change-badge" IsVisible="{Binding IsChanged}">
              <TextBlock Text="CHANGED" />
            </Border>
          </Grid>
          <SelectableTextBlock Text="{Binding Value}" FontSize="12"
                               FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                               Foreground="#DCE5F4" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChangeText}" IsVisible="{Binding IsChanged}"
                     FontSize="10" Foreground="#F6C177"
                     FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="X11RecordTemplate" x:DataType="models:X11RecordedEvent">
      <Grid ColumnDefinitions="86,116,104,*" ColumnSpacing="8" Margin="0,1">
        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#66758C"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="10" Foreground="#9BC0FF"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding WindowHex}" FontSize="10" Foreground="#F0B57D"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Foreground="#C6D3E8"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Summary}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="EventTemplate" x:DataType="models:WindowEventRecord">
      <Grid ColumnDefinitions="86,64,96,*" ColumnSpacing="8" Margin="0,1">
        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#66758C"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <Border Grid.Column="1" Classes="tag" HorizontalAlignment="Left"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding Source}" />
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding KindText}" FontSize="10" Foreground="#9BC0FF"
                   FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11" Foreground="#C6D3E8"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   ToolTip.Tip="{Binding Summary}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="X11ChildTemplate" x:DataType="models:X11ChildInfo">
      <Border Classes="card" Margin="0,0,0,3" Padding="9,6">
        <SelectableTextBlock Text="{Binding DisplayText}" FontSize="11"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             Foreground="#C6D3E8" TextWrapping="Wrap" />
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ProviderTemplate" x:DataType="models:ProviderStatus">
      <Border Classes="provider" Classes.available="{Binding Available}">
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
            <Border Grid.Column="1">
              <Border Classes="badge" Classes.accent="{Binding Available}">
                <TextBlock Text="{Binding AvailabilityText}" />
              </Border>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Detail}" Classes="hint" />
          <TextBlock Text="{Binding CapabilityText}" Classes="hint" Foreground="#6E7F98" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Top bar -->
    <Border Grid.Row="0" Background="#0E131D" BorderBrush="#222B3B" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="11" Background="#4F8CFF">
            <TextBlock Text="TV" FontSize="15" FontWeight="Bold" Foreground="#08101E"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="TuxViewer" FontSize="20" FontWeight="Bold" LetterSpacing="0.4" />
            <TextBlock Text="Linux 桌面环境 / 窗口检视器" FontSize="11" Foreground="#7E8CA3" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Classes="badge accent">
            <TextBlock Text="{Binding SessionSummary}" />
          </Border>
          <Border Classes="badge">
            <TextBlock Text="{Binding CountsText}" />
          </Border>
          <Border Classes="badge" IsVisible="{Binding AutoRefresh}">
            <TextBlock Text="{Binding AutoRefreshBadge}" />
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
          <Button Content="刷新" Click="Refresh_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="刷新窗口列表 (F5)" />
          <Button Content="当前焦点" Click="Focused_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="读取当前聚焦的窗口" />
          <Button Content="点击拾取" Click="Pick_Click" Classes="pick"
                  IsEnabled="{Binding IsIdle}" ToolTip.Tip="点击模式：单击目标窗口 (F2)" />
          <Button Content="拖动拾取" Click="PickDrag_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="拖动模式：按住左键拖动准星，松开确认 (F3)" />
          <Button Content="X11 拾取" Click="PickX11_Click" Classes="ghost" IsEnabled="{Binding IsIdle}"
                  ToolTip.Tip="只使用 X11 指针抓取（Shift+F2 / Shift+F3），仅 X11 / XWayland 窗口" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid Grid.Row="1">
      <Grid ColumnDefinitions="470,6,*">

        <!-- Window list -->
        <Border Grid.Column="0" Classes="panel" Margin="12,12,0,12" ClipToBounds="True">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="12,12,12,0" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBox Grid.Row="0" PlaceholderText="搜索标题、应用 ID、PID、窗口 ID…"
                       Text="{Binding FilterText, Mode=TwoWay}" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding BackendFilters}"
                          SelectedIndex="{Binding BackendFilterIndex, Mode=TwoWay}" />
                <ToggleButton Grid.Column="1" Content="自动刷新" Classes="chip"
                              IsChecked="{Binding AutoRefresh, Mode=TwoWay}" Margin="8,0,0,0" />
              </Grid>
              <WrapPanel Grid.Row="2" Margin="0,8,0,0" ItemSpacing="5" LineSpacing="5">
                <ToggleButton Content="隐藏本应用" Classes="chip"
                              IsChecked="{Binding HideOwnWindows, Mode=TwoWay}" />
                <ToggleButton Content="含原始 X11" Classes="chip"
                              IsChecked="{Binding IncludeRawX11, Mode=TwoWay}"
                              ToolTip.Tip="显示已合并到 Wayland 条目中的原始 X11 窗口" />
                <ToggleButton Content="含未映射" Classes="chip"
                              IsChecked="{Binding IncludeUnmapped, Mode=TwoWay}" />
                <ToggleButton Content="实时事件" Classes="chip"
                              IsChecked="{Binding RealtimeEnabled, Mode=TwoWay}"
                              ToolTip.Tip="监听 X11 PropertyNotify / niri / Sway / Hyprland 事件" />
                <ToggleButton Content="树形视图" Classes="chip"
                              IsChecked="{Binding TreeMode, Mode=TwoWay}"
                              ToolTip.Tip="按应用 / 进程 / 工作区分组，并展开 X11 子窗口" />
                <ToggleButton Content="仅此 PID" Classes="chip"
                              IsChecked="{Binding OnlySelectedPid, Mode=TwoWay}"
                              ToolTip.Tip="只显示当前选中窗口的 PID 的所有窗口" />
              </WrapPanel>
              <Grid Grid.Row="3" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                    Margin="0,8,0,0" IsVisible="{Binding TreeMode}">
                <TextBlock Text="分组方式" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding TreeGroupModes}"
                          SelectedIndex="{Binding TreeGroupModeIndex, Mode=TwoWay}" />
              </Grid>
            </Grid>

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12,12,6">
              <TextBlock Text="窗口 / TOPLEVEL" Classes="section" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="来源 · 后端 · 几何" FontSize="11" Foreground="#66758C" />
            </Grid>

            <ListBox ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                     Margin="8,0,8,8" IsVisible="{Binding !TreeMode}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:WindowInfo">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" Height="44">
                    <Panel Width="36" Height="36" VerticalAlignment="Center">
                      <Border CornerRadius="9" Background="#1B2638" BorderBrush="#2A3850"
                              BorderThickness="1">
                        <TextBlock Text="{Binding IconInitial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AFC3E4" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="9" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 LineHeight="18" TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Border Classes="tag" Classes.x11="{Binding IsX11}"
                                Classes.wl="{Binding IsWayland}"
                                ToolTip.Tip="{Binding BackendLabel}">
                          <TextBlock Text="{Binding BackendShort}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="#7E8CA3" LineHeight="15"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#93A4BC"
                                 FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                 LineHeight="14" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding FocusGlyph}" FontSize="10" Foreground="#4F8CFF"
                                 LineHeight="14" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TreeView ItemsSource="{Binding WindowTree}"
                      SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                      IsVisible="{Binding TreeMode}" Margin="8,0,8,8">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="Padding" Value="2,1" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:WindowNode">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8" Height="44" Margin="0,1">
                    <Panel Width="36" Height="36" VerticalAlignment="Center">
                      <Border CornerRadius="9" Background="#1B2638" BorderBrush="#2A3850"
                              BorderThickness="1">
                        <TextBlock Text="{Binding IconInitial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#AFC3E4" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                      </Border>
                      <Border CornerRadius="9" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                        <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                      </Border>
                    </Panel>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                 LineHeight="18" TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Border Classes="tag" Classes.x11="{Binding IsX11}"
                                Classes.wl="{Binding IsWayland}"
                                IsVisible="{Binding IsWindow}"
                                ToolTip.Tip="{Binding BackendLabel}">
                          <TextBlock Text="{Binding BackendShort}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Subtitle}" FontSize="11"
                                   Foreground="#7E8CA3" LineHeight="15"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                      <TextBlock Text="{Binding GeometryText}" FontSize="10" Foreground="#93A4BC"
                                 FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                 LineHeight="14" HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding FocusGlyph}" FontSize="10" Foreground="#4F8CFF"
                                 LineHeight="14" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </Border>

        <!-- Details -->
        <Border Grid.Column="2" Classes="panel" Margin="0,12,12,12" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#101724" BorderBrush="#232C3D" BorderThickness="0,0,0,1"
                    Padding="16,12">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                  <TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="Bold"
                             LineHeight="24" Height="28" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SelectedTitle}" />
                  <TextBlock Text="{Binding SelectedSubtitle}" FontSize="11" Foreground="#7E8CA3"
                             LineHeight="16" Height="18" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding SelectedSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Top">
                  <Border Classes="badge" Classes.x11="{Binding SelectedWindow.IsX11}"
                          Classes.wl="{Binding SelectedWindow.IsWayland}">
                    <TextBlock Text="{Binding SelectedBackend}" />
                  </Border>
                  <Border Classes="badge">
                    <TextBlock Text="{Binding SelectedPid}" />
                  </Border>
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                      Margin="0,10,0,0">
                  <Button Content="复制摘要" Click="CopySummary_Click" Classes="ghost" IsEnabled="{Binding HasSelection}" />
                  <Button Grid.Column="1" Content="复制 JSON" Click="CopyJson_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <Button Grid.Column="2" Content="截图" Click="Screenshot_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0"
                          ToolTip.Tip="捕获选中窗口（X11 XGetImage / niri / grim）" />
                  <Button Grid.Column="3" Content="高亮" Click="Highlight_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0"
                          ToolTip.Tip="在 X11 屏幕上绘制边框；Wayland 窗口请用“聚焦”" />
                  <Button Grid.Column="4" Content="聚焦" Click="Focus_Click" Classes="ghost"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <Button Grid.Column="5" Content="关闭窗口" Click="Close_Click" Classes="danger"
                          IsEnabled="{Binding HasSelection}" Margin="6,0,0,0" />
                  <TextBlock Grid.Column="6" Text="{Binding SelectedId, StringFormat='ID {0}'}" Classes="muted" FontSize="10"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </Grid>
              </Grid>
            </Border>

            <TabControl Grid.Row="1" Margin="10,8,10,10"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
              <TabItem Header="概览">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="窗口属性" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding OverviewRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <Border Classes="divider" />
                    <TextBlock Classes="hint"
                               Text="“后端”为 X11 时表示该窗口是 X11 客户端；在 Wayland 会话下它就是 XWayland 窗口。进程页会进一步显示它实际连接的 X11 / Wayland socket，以及 GTK/Qt/Electron/Flutter 等工具包证据。" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="进程">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="{Binding ProcessHeader}" FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="工具包证据" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ToolkitEvidence}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="关键动态库" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding KeyLibraries}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                       FontSize="10" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="X11 属性">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="6,8,10,8">
                  <TextBlock Grid.Row="0" Text="X11 窗口属性" Classes="section" Margin="0,0,0,6" />
                  <ScrollViewer Grid.Row="1" MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Rows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                  </ScrollViewer>
                  <TextBlock Grid.Row="2" Text="{Binding X11Details.Properties.Count, StringFormat='{}{0} 个 X11 属性（点击复制）'}"
                             Classes="section" Margin="0,12,0,6" />
                  <ScrollViewer Grid.Row="3" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Properties}" ItemTemplate="{StaticResource X11PropertyTemplate}" />
                  </ScrollViewer>
                  <TextBlock Grid.Row="4" Text="{Binding X11Details.Children.Count, StringFormat='{}{0} 个子窗口'}"
                             Classes="section" Margin="0,12,0,6" IsVisible="{Binding HasX11Details}" />
                  <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding X11Children}" ItemTemplate="{StaticResource X11ChildTemplate}" />
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <TabItem Header="Wayland">
                <Grid RowDefinitions="Auto,*" Margin="6,8,10,8">
                  <ItemsControl Grid.Row="0" ItemsSource="{Binding WaylandRows}"
                                ItemTemplate="{StaticResource InfoRowTemplate}" />
                  <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="合成器原始数据" Classes="section" Margin="0,0,0,6" />
                      <SelectableTextBlock Text="{Binding NativeJson}" FontSize="11"
                                           FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                                           Foreground="#B9C9E2" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>

              <TabItem Header="环境">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12">
                    <TextBlock Text="进程环境变量（优先级排序）" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding EnvironmentRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <Border Classes="divider" />
                    <TextBlock Text="socket 连接" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SocketRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="原始数据">
                <Grid RowDefinitions="Auto,*" Margin="6,8,10,8">
                  <TextBlock Grid.Row="0" Text="完整检视 JSON（窗口 + 进程 + X11 属性 + socket + 环境）"
                             Classes="section" Margin="0,0,0,6" />
                  <TextBox Grid.Row="1" Text="{Binding RawJson}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                           FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Grid>
              </TabItem>

              <TabItem Header="事件">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6,8,10,8">
                  <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="实时事件" Classes="section" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Classes="badge accent" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RealtimeSummary}" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding EventCountText}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Content="清空" Click="ClearEvents_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                      <Button Grid.Column="4" Content="复制" Click="CopyEvents_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="hint" Margin="0,6,0,0"
                               Text="实时事件来自 X11 PropertyNotify / ConfigureNotify / Map / Destroy / Focus、niri event-stream、Sway subscribe 和 Hyprland socket2。属性变化会在“概览”和“X11 属性”页标黄并显示旧值。" />
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding Events}"
                           ItemTemplate="{StaticResource EventTemplate}">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                  <TextBlock Grid.Row="2" Classes="hint" Margin="0,6,0,0"
                             Text="提示：事件列表只保留最近 800 条；暂停“实时事件”开关后不再记录。" />
                </Grid>
              </TabItem>

              <TabItem Header="截图">
                <Grid RowDefinitions="Auto,*,Auto" Margin="6,8,10,8">
                  <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                      <Button Content="重新截图" Click="Screenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasSelection}" FontSize="11" Padding="9,4" />
                      <Button Grid.Column="1" Content="保存 PNG" Click="SaveScreenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasScreenshot}" FontSize="11" Padding="9,4" />
                      <Button Grid.Column="2" Content="复制图片" Click="CopyScreenshot_Click" Classes="ghost"
                              IsEnabled="{Binding HasScreenshot}" FontSize="11" Padding="9,4" />
                      <TextBlock Grid.Column="4" Text="{Binding ScreenshotStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="520"
                                 ToolTip.Tip="{Binding ScreenshotStatus}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="hint" Margin="0,6,0,0"
                               Text="X11 / XWayland 使用 XGetImage 精确截取窗口；niri 使用 screenshot-window；Sway / Hyprland 使用 grim 按窗口几何截取；GNOME 尝试 gnome-screenshot。" />
                  </Grid>
                  <Border Grid.Row="1" Classes="panel" Background="#0A0E15" ClipToBounds="True">
                    <Panel>
                      <Image Source="{Binding ScreenshotImage}" Stretch="Uniform" Margin="10"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <TextBlock Text="尚未截图 · 点击工具栏“截图”或上方“重新截图”"
                                 Classes="muted" FontSize="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasScreenshot}" />
                    </Panel>
                  </Border>
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ScreenshotSource, StringFormat='来源：{0}'}"
                               Classes="muted" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint"
                               Text="截图仅保存在内存中，点击“保存 PNG”写入磁盘。" />
                  </Grid>
                </Grid>
              </TabItem>

              <TabItem Header="规则">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="Auto,180,*,Auto" ColumnSpacing="10">
                      <TextBlock Text="目标合成器" Classes="section" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding RuleCompositors}"
                                SelectedIndex="{Binding RuleCompositorIndex, Mode=TwoWay}" />
                      <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                                 Text="根据选中窗口生成可直接粘贴的配置" />
                    </Grid>

                    <WrapPanel ItemSpacing="12" LineSpacing="6">
                      <CheckBox Content="浮动" IsChecked="{Binding RuleFloating, Mode=TwoWay}" />
                      <CheckBox Content="全屏" IsChecked="{Binding RuleFullscreen, Mode=TwoWay}" />
                      <CheckBox Content="无边框" IsChecked="{Binding RuleNoBorder, Mode=TwoWay}" />
                      <CheckBox Content="固定 / Sticky" IsChecked="{Binding RuleSticky, Mode=TwoWay}" />
                      <CheckBox Content="同时匹配标题" IsChecked="{Binding RuleMatchTitle, Mode=TwoWay}" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,110,Auto,110,Auto,160,*" ColumnSpacing="8">
                      <TextBlock Text="宽度" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding RuleWidth, Mode=TwoWay}"
                               PlaceholderText="留空表示不限制" />
                      <TextBlock Grid.Column="2" Text="高度" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding RuleHeight, Mode=TwoWay}"
                               PlaceholderText="留空表示不限制" />
                      <TextBlock Grid.Column="4" Text="工作区" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="5" Text="{Binding RuleWorkspace, Mode=TwoWay}"
                               PlaceholderText="名称 / 编号" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,110,*" ColumnSpacing="8">
                      <TextBlock Text="不透明度" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding RuleOpacity, Mode=TwoWay}"
                               PlaceholderText="0.0 - 1.0" />
                      <TextBlock Grid.Column="2" Classes="hint" VerticalAlignment="Center"
                                 Text="留空表示不生成透明度规则；niri / Sway / Hyprland 支持程度不同" />
                    </Grid>

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="生成的配置" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="复制规则" Click="CopyRule_Click"
                              Classes="ghost" FontSize="11" Padding="9,4" />
                    </Grid>
                    <TextBox Text="{Binding GeneratedRule}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             FontSize="12" MinHeight="260"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Classes="hint"
                               Text="生成结果只是起点：请确认 app-id / class / title 与应用一致，再按注释中的路径粘贴并重载配置。匹配标题会随窗口标题变化而失效。" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="X11 事件">
                <Grid RowDefinitions="Auto,Auto,*" Margin="6,8,10,8">
                  <Grid RowDefinitions="Auto,Auto">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="X11 RECORD" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="{Binding X11RecordButtonText}"
                              Click="ToggleX11Record_Click" Classes="pick"
                              FontSize="11" Padding="10,4" />
                      <TextBlock Grid.Column="2" Text="{Binding X11RecordStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding X11EventCountText}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" />
                      <Button Grid.Column="4" Content="清空" Click="ClearX11Events_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                      <Button Grid.Column="5" Content="复制" Click="CopyX11Events_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0" ItemSpacing="12" LineSpacing="5">
                      <CheckBox Content="键盘" IsChecked="{Binding X11RecordKeys, Mode=TwoWay}" />
                      <CheckBox Content="鼠标" IsChecked="{Binding X11RecordMouse, Mode=TwoWay}" />
                      <CheckBox Content="Configure" IsChecked="{Binding X11RecordConfigure, Mode=TwoWay}" />
                      <CheckBox Content="Property" IsChecked="{Binding X11RecordProperty, Mode=TwoWay}" />
                      <CheckBox Content="Focus" IsChecked="{Binding X11RecordFocus, Mode=TwoWay}" />
                      <CheckBox Content="Map / Unmap" IsChecked="{Binding X11RecordMap, Mode=TwoWay}" />
                      <CheckBox Content="ClientMessage" IsChecked="{Binding X11RecordClientMessage, Mode=TwoWay}" />
                      <CheckBox Content="其他" IsChecked="{Binding X11RecordOther, Mode=TwoWay}" />
                      <CheckBox Content="只监视选中窗口" IsChecked="{Binding X11RecordOnlySelected, Mode=TwoWay}" />
                    </WrapPanel>
                  </Grid>
                  <TextBlock Grid.Row="1" Classes="hint" Margin="0,8,0,8"
                             Text="使用 libXtst RECORD 扩展全局记录事件，不需要修改目标窗口的 event mask。修改过滤条件立即生效；Record 事件与上方“实时事件”相互独立。" />
                  <ListBox Grid.Row="2" ItemsSource="{Binding X11Events}"
                           ItemTemplate="{StaticResource X11RecordTemplate}">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="Margin" Value="0" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </Grid>
              </TabItem>

              <TabItem Header="控件">
                <Grid RowDefinitions="Auto,Auto,*" Margin="6,8,10,8">
                  <Grid RowDefinitions="Auto" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="AT-SPI 控件树" Classes="section" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="加载控件树" Click="LoadAtspi_Click"
                            Classes="ghost" FontSize="11" Padding="9,4" />
                    <Button Grid.Column="2" Content="复制" Click="CopyAtspi_Click"
                            Classes="ghost" FontSize="11" Padding="9,4" />
                    <TextBlock Grid.Column="3" Text="{Binding AtspiStatus}" Classes="muted"
                               FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding AtspiStatus}" />
                    <TextBlock Grid.Column="4" Text="{Binding AtspiCountText}" Classes="muted"
                               FontSize="11" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Row="1" Classes="hint" Margin="0,8,0,8"
                             Text="通过 AT-SPI2 / python3-gi 读取 GTK、Qt 等应用的无障碍控件树。应用必须启用无障碍桥（例如 GTK_MODULES=gail:atk-bridge、QT_ACCESSIBILITY=1 或桌面“屏幕阅读器”支持）。未精确匹配时会显示全部已注册应用。" />
                  <Panel Grid.Row="2">
                    <TreeView ItemsSource="{Binding AtspiTree}">
                      <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                          <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                        </Style>
                      </TreeView.Styles>
                      <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="models:AtspiNode">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinHeight="30" Margin="0,1">
                            <Border Classes="tag" VerticalAlignment="Center" MaxWidth="180">
                              <TextBlock Text="{Binding RoleShort}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                              <TextBlock Text="{Binding Title}" FontSize="12"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                                         FontSize="10" Foreground="#7E8CA3"
                                         TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </TreeDataTemplate>
                      </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock Text="尚未加载 · 点击上方“加载控件树”"
                               Classes="muted" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasAtspiTree}" />
                  </Panel>
                </Grid>
              </TabItem>

              <TabItem Header="热键">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <TextBlock Text="全局拾取热键" Classes="section" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Button Content="{Binding GlobalHotkeyButtonText}" Click="ToggleHotkey_Click"
                              Classes="pick" FontSize="11" Padding="10,4" />
                      <TextBlock Grid.Column="1" Text="{Binding GlobalHotkeyStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Border Grid.Column="2" Classes="badge accent">
                        <TextBlock Text="Ctrl+Alt+X" />
                      </Border>
                    </Grid>
                    <TextBlock Classes="hint"
                               Text="启用后通过 X11 XGrabKey 注册系统级 Ctrl+Alt+X。X11 会话可直接使用；Wayland 会话只有合成器把按键路由到 XWayland 时才生效，因此下方同时提供各合成器原生快捷键配置。" />

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="合成器快捷键配置" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="复制配置" Click="CopyHotkey_Click"
                              Classes="ghost" FontSize="11" Padding="9,4" />
                    </Grid>
                    <TextBox Text="{Binding HotkeyConfig}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,DejaVu Sans Mono,monospace"
                             FontSize="12" MinHeight="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBlock Classes="hint"
                               Text="将对应行加入合成器配置并重载后，按下 Super+Shift+X 会启动 TuxViewer 的 X11 拾取模式。适合 Wayland 原生窗口（XWayland 窗口）以及 niri / Sway / Hyprland。" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="控制">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="窗口状态" Classes="section" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ControlStatus}" Classes="muted"
                                 FontSize="11" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="520"
                                 ToolTip.Tip="{Binding ControlStatus}" />
                    </Grid>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <Button Content="置顶" Tag="above" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="置底" Tag="below" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="取消置顶 / 置底" Tag="clearabove" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="全屏" Tag="fullon" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="退出全屏" Tag="fulloff" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="切换浮动" Tag="floating" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="启用 Sticky" Tag="stickyon" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="取消 Sticky" Tag="stickoff" Click="ControlAction_Click" Classes="ghost" />
                    </WrapPanel>

                    <Border Classes="divider" />
                    <TextBlock Text="不透明度（X11 / XWayland）" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                      <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                              Value="{Binding OpacityValue, Mode=TwoWay}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding OpacityValue, StringFormat='{}{0:0}%'}"
                                 Classes="muted" VerticalAlignment="Center" MinWidth="42" />
                      <Button Grid.Column="2" Content="应用" Tag="opacity"
                              Click="ControlAction_Click" Classes="ghost" />
                      <Button Grid.Column="3" Content="清除" Tag="clearopacity"
                              Click="ControlAction_Click" Classes="ghost" />
                    </Grid>

                    <Border Classes="divider" />
                    <TextBlock Text="几何（X11 / Sway；niri 只支持宽高）" Classes="section" />
                    <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,100,Auto,100,*" ColumnSpacing="8">
                      <TextBlock Text="X" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" Text="{Binding GeoX, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="Y" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="3" Text="{Binding GeoY, Mode=TwoWay}" />
                      <TextBlock Grid.Column="4" Text="宽" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="5" Text="{Binding GeoW, Mode=TwoWay}" />
                      <TextBlock Grid.Column="6" Text="高" Classes="muted" VerticalAlignment="Center" />
                      <TextBox Grid.Column="7" Text="{Binding GeoH, Mode=TwoWay}" />
                      <Button Grid.Column="8" Content="应用几何" Tag="geometry"
                              Click="ControlAction_Click" Classes="ghost" HorizontalAlignment="Left" />
                    </Grid>

                    <Border Classes="divider" />
                    <TextBlock Text="进程" Classes="section" />
                    <ItemsControl ItemsSource="{Binding ProcessRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="6" Margin="0,8,0,0">
                      <Button Content="发送关闭请求" Tag="close" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="{Binding ForceKillButtonText}" Tag="kill"
                              Click="ControlAction_Click" Classes="danger" />
                      <Button Content="打开可执行文件目录" Tag="openfolder" Click="ControlAction_Click" Classes="ghost" />
                      <Button Content="复制进程信息" Tag="copyproc" Click="ControlAction_Click" Classes="ghost" />
                    </WrapPanel>
                    <TextBlock Classes="hint"
                               Text="“强制结束”只会对 X11 / XWayland 客户端调用 XKillClient，需要二次点击确认；Wayland 原生窗口请使用合成器或应用自身的退出方式。" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>

              <TabItem Header="诊断">
                <ScrollViewer>
                  <StackPanel Margin="6,8,10,12" Spacing="2">
                    <TextBlock Text="会话" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding SessionRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="实时监控" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding RealtimeRows}" ItemTemplate="{StaticResource InfoRowTemplate}" />

                    <Border Classes="divider" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                      <TextBlock Text="窗口后端" Classes="section" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="刷新诊断" Click="RefreshDiagnostics_Click"
                              Classes="ghost" FontSize="11" Padding="8,4" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource ProviderTemplate}" />

                    <Border Classes="divider" />
                    <TextBlock Text="Wayland 全局协议（wayland-info）" Classes="section" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding WaylandProtocols}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel ItemSpacing="5" LineSpacing="5" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding}" FontSize="10" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="divider" />
                    <TextBlock Text="GNOME 支持" Classes="section" Margin="0,0,0,6" />
                    <TextBlock Classes="hint"
                               Text="GNOME Shell 默认禁止第三方读取窗口列表。TuxViewer 附带一个可选扩展，安装并重新登录后即可枚举窗口和按指针拾取。" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                      <Button Content="安装 GNOME 扩展" Click="InstallGnome_Click" Classes="ghost" />
                      <TextBlock Text="{Binding GnomeInstallStatus}" Classes="hint" VerticalAlignment="Center"
                                 MaxWidth="520" />
                    </StackPanel>

                    <Border Classes="divider" />
                    <TextBlock Text="限制说明" Classes="section" Margin="0,0,0,6" />
                    <TextBlock Classes="hint"
                               Text="Wayland 不允许普通客户端全局抓取输入或读取其他窗口内容。TuxViewer 会按合成器选择原生方案：niri pick-window、KWin queryWindowInfo、Hyprland 指针坐标、Sway 聚焦窗口、GNOME 扩展。X11 / XWayland 窗口则使用真正的全局指针抓取。" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>

      <!-- Pick banner -->
      <Border IsVisible="{Binding IsPicking}" ZIndex="10"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"
              Background="#F2172338" BorderBrush="#4F8CFF" BorderThickness="1" CornerRadius="10"
              Padding="14,10" BoxShadow="0 8 30 0 #80000000">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="◎" FontSize="20" Foreground="#7EABFF" VerticalAlignment="Center" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding PickBanner}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="提示：点击模式单击目标；拖动模式按住拖动后松开；右键 / Esc 取消" FontSize="10" Foreground="#7E8CA3" />
          </StackPanel>
          <Border Classes="badge accent" IsVisible="{Binding HasPickCountdown}">
            <TextBlock Text="{Binding PickCountdown}" />
          </Border>
          <Button Content="取消" Click="CancelPick_Click" Classes="ghost" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#0E131D" BorderBrush="#222B3B" BorderThickness="0,1,0,0"
            Padding="14,6">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#93A4BC"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Session.SessionType}" FontSize="10"
                   Foreground="#66758C" Margin="10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding LastUpdatedText, StringFormat='更新 {0}'}"
                   FontSize="10" Foreground="#66758C" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
